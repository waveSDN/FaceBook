# Local-only default. A remote bind requires WIS_ADMIN_TOKEN and production HTTPS controls.
HOST=127.0.0.1
PORT=3000
WIS_ADMIN_TOKEN=

# Messenger webhook and send API. All fields are required for an active connection.
MESSENGER_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_GRAPH_API_VERSION=

# Gemini classifies intent and selects a constrained reply strategy; backend owns policy.
GEMINI_API_KEY=
GEMINI_MODEL=

# WIS business WhatsApp number, international digits without "+".
WIS_WHATSAPP_NUMBER=
